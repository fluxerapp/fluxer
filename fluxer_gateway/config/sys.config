% SPDX-License-Identifier: AGPL-3.0-or-later
[
    {kernel, [
        {logger_level, warning},
        {logger, [
            {handler, default, logger_std_h, #{
                config => #{
                    sync_mode_qlen => 100,
                    drop_mode_qlen => 2000,
                    flush_qlen => 5000,
                    burst_limit_enable => true,
                    burst_limit_max_count => 2000,
                    burst_limit_window_time => 1000,
                    overload_kill_enable => false
                },
                formatter =>
                    {logger_formatter, #{
                        legacy_header => false,
                        single_line => true,
                        template => [
                            time, " ", level, " ",
                            {pid, [pid, " "], []},
                            {mfa, [mfa, " "], []},
                            msg, "\n"
                        ],
                        chars_limit => 16384,
                        max_size => 16384,
                        depth => 30
                    }}
            }}
        ]}
    ]},
    {sasl, [
        {errlog_type, error}
    ]},
    {inet, [
        {lookup, [native, file, dns]}
    ]}
].
