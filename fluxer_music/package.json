{
	"name": "@fluxer/music",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		"./*": "./*"
	},
	"scripts": {
		"build": "esbuild src/Main.ts --bundle --platform=node --format=esm --target=node26 --external:@livekit/rtc-node --outfile=dist/Main.js",
		"test": "vitest run",
		"test:integration": "vitest run --config vitest.integration.config.ts",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@fluxer/music_protocol": "workspace:*",
		"@livekit/rtc-node": "1.1.0"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"@types/ws": "8.18.1",
		"esbuild": "catalog:",
		"livekit-server-sdk": "catalog:",
		"typescript": "catalog:ts7",
		"vitest": "catalog:",
		"ws": "8.21.3"
	}
}
