{
	"name": "fluxer",
	"private": true,
	"scripts": {
		"build": "cargo run -p fluxer-dev -- build",
		"dev": "cargo run -p fluxer-dev -- dev",
		"dev:bootstrap": "cargo run -p fluxer-dev -- bootstrap",
		"dev:cassandra:apply": "cargo run -p fluxer-dev -- cassandra apply",
		"dev:cassandra:diff": "cargo run -p fluxer-dev -- cassandra diff",
		"dev:cassandra:verify": "cargo run -p fluxer-dev -- cassandra verify",
		"dev:desktop:app": "cargo run -p fluxer-dev -- desktop app",
		"dev:desktop:build": "cargo run -p fluxer-dev -- desktop build",
		"dev:desktop:deps": "cargo run -p fluxer-dev -- desktop deps",
		"dev:desktop:install": "cargo run -p fluxer-dev -- desktop install",
		"dev:desktop:package": "cargo run -p fluxer-dev -- desktop package",
		"dev:desktop:pkgs": "cargo run -p fluxer-dev -- desktop pkgs",
		"dev:desktop:run": "cargo run -p fluxer-dev -- desktop run",
		"dev:infra:restart": "pnpm dev:infra:stop && pnpm dev:infra:start",
		"dev:infra:start": "cargo run -p fluxer-dev -- infra start",
		"dev:infra:status": "cargo run -p fluxer-dev -- infra status",
		"dev:infra:stop": "cargo run -p fluxer-dev -- infra stop",
		"dev:services": "cargo run -p fluxer-dev -- rust-services",
		"dev:tunnel": "cargo run -p fluxer-dev -- dev --cloudflare-tunnel",
		"dev:tunnel:configure": "cargo run -p fluxer-dev -- tunnel configure",
		"dev:tunnel:env": "cargo run -p fluxer-dev -- tunnel print-env",
		"dev:tunnel:run": "cargo run -p fluxer-dev -- tunnel run",
		"docs:build": "pnpm --filter fluxer_docs build",
		"docs:dev": "pnpm --filter fluxer_docs dev",
		"docs:typecheck": "pnpm --filter fluxer_docs typecheck",
		"i18n:compile": "pnpm --filter fluxer_app i18n:compile && pnpm --filter @fluxer/i18n static:sync && pnpm --filter @fluxer/i18n generate:types && pnpm --filter @pkgs/email html:compile",
		"i18n:refresh": "pnpm --filter fluxer_app i18n:refresh",
		"i18n:source-sync": "pnpm i18n:refresh && pnpm i18n:compile",
		"knip": "tools/ci/run.sh ci --step knip",
		"lint": "biome ci && eslint . --max-warnings 0 && pnpm --filter fluxer_app theming:data-flx:check && pnpm --filter @fluxer/config self-host-env:check",
		"openapi:generate": "pnpm --filter @fluxer/openapi generate",
		"openapi:validate": "pnpm --filter @fluxer/openapi validate",
		"test": "tools/ci/run.sh ci --step test",
		"typecheck": "tools/ci/run.sh ci --step typecheck"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"eslint": "catalog:",
		"eslint-plugin-react-google-translate": "catalog:",
		"knip": "catalog:",
		"typescript": "catalog:",
		"typescript-eslint": "catalog:",
		"vite": "catalog:"
	},
	"packageManager": "pnpm@11.27.0"
}
