#. Description text in the messages tab.
#: src/features/user/components/modals/tabs/appearance_tab/MessagesTab.tsx
msgid "... turn dense mode on. Nice!"
msgstr "...otat tiiviin tilan käyttöön. Hienoa!"

#. Button or menu action label in the channel and chat user message. Keep it concise.
#. Suffix after the message text in the forward modal preview when the forwarded message was edited.
#: src/features/channel/components/MessageAttachments.tsx
#: src/features/channel/components/UserMessage.tsx
#: src/features/messaging/components/modals/ForwardMessagePreview.tsx
