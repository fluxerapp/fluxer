#: src/features/guild/utils/guild_tabs/audit_log/AuditLogChannelMessages.ts
msgid "{actor} removed the permission override for the role {role} from {channel}"
msgstr "{actor} הסיר את עקיפת ההרשאות עבור התפקיד {role} מ-{channel}"

