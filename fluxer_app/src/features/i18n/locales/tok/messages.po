#. Problem shown in the quick CSS editor on var() of a CSS variable that does not exist. {name} is the variable name without its leading dashes.
#: src/features/theme_settings/editor/CssLint.ts
msgid "--{name} isn't a Fluxer variable and isn't set anywhere in your CSS."
msgstr "--{name} li nimi pi ilo Fluxer ala. CSS sina kin li pana ala e ona."

#. Description text in the messages tab.
#: src/features/user/components/modals/tabs/appearance_tab/MessagesTab.tsx
msgid "... turn dense mode on. Nice!"
msgstr "… o open e nasin pi lukin lili. pona a!"

#. Error at the bottom of the setup wizard branding step when an uploaded image could not be loaded from the server. label is the name of the image field, such as Sign-in background.
#: src/features/app/components/setup/SetupBrandingStep.tsx
msgid "\"{label}\" was saved but could not be loaded back."
msgstr "mi awen e \"{label}\", taso mi ken ala open sin e ona."

#. Button or menu action label in the channel and chat user message. Keep it concise.
#. Suffix after the message text in the forward modal preview when the forwarded message was edited.
#: src/features/channel/components/MessageAttachments.tsx
#: src/features/channel/components/UserMessage.tsx
#: src/features/messaging/components/modals/ForwardMessagePreview.tsx
msgid "(edited)"
msgstr "(ante)"

#: src/features/app/components/pages/YouPage.tsx
#: src/features/user/components/modals/UserProfileMobileSheet.tsx
msgid "(only visible to you)"
msgstr "(sina taso li lukin e ni)"

#. Short label in the keybinds tab. Keep it concise.
#: src/features/user/components/modals/tabs/keybinds_tab/CustomKeybindsList.tsx
msgid "(unassigned)"
msgstr "(ala)"

#: src/features/channel/components/bottomsheets/channel_details_bottom_sheet/DMMembersList.tsx
msgid "(you)"
msgstr "(sina)"

#. Replaces the text of a copy of a published announcement after the original was deleted in the announcement channel. Keep the square brackets.
#: src/features/channel/components/UserMessage.tsx
msgid "[Original message deleted]"
msgstr "[toki open li weka]"

#. placeholder {0}: guild.member_count
#: src/features/discovery/discovery/DiscoveryGuildCard.tsx
msgid "{0, plural, one {# member} other {# members}}"
msgstr "{0, plural, other {jan kulupu #}}"

#. Screen reader announcement in the composer when two people are typing. {a} and {b} are their display names.
#: src/features/typing/rolling/RollingTypingText.tsx
msgid "{a} and {b} are typing..."
msgstr "{a} en {b} li sitelen…"

#. Screen reader announcement in the composer when one person is typing. {a} is their display name.
#: src/features/typing/rolling/RollingTypingText.tsx
msgid "{a} is typing..."
msgstr "{a} li sitelen…"

#. Screen reader announcement in the composer when three people are typing. {a}, {b} and {c} are their display names.
#: src/features/typing/rolling/RollingTypingText.tsx
msgid "{a}, {b} and {c} are typing..."
msgstr "{a} en {b} en {c} li sitelen…"

#. Names the receiving account in a desktop notification when the signed-in accounts are on more than one instance. host is the instance address, such as fluxer.example.com.
#. Quick switcher section header and row label for another signed-in account when accounts span several instances. accountName is the account display name and host is the instance host name.
#: src/features/notification/utils/AccountEngineNotifications.ts
#: src/features/search/state/QuickSwitcherAccountResults.ts
msgid "{accountName} on {host}"
msgstr "{accountName} lon {host}"

#. Button on the startup screen that restarts the app on another signed-in account. accountName is the account's display name and instanceHost the host of its instance, such as chat.example.com.
#: src/features/app/components/BootstrapErrorScreen.tsx
msgid "{accountName} on {instanceHost}"
msgstr "{accountName} lon {instanceHost}"

#. Activity log summary when a channel got a permission override for one member. A permission override is a channel-level exception to the permissions of a role or member. It allows or denies chosen permissions in one channel or category only. Use the same word for override as the channel permissions settings, such as Add override. {actor} is the member who made the change, shown as a clickable user chip, or the word System. {user} is the member the override applies to, shown as a clickable user chip. {channel} is the channel, shown as a channel chip with its name.
#: src/features/guild/utils/guild_tabs/audit_log/AuditLogChannelMessages.ts
msgid "{actor} added a permission override for {user} in {channel}"
msgstr "{actor} li pana e ken namako tawa {user} lon {channel}"

#. Activity log summary when a channel got a permission override for every member of the community. A permission override is a channel-level exception to the permissions of a role or member. It allows or denies chosen permissions in one channel or category only. Use the same word for override as the channel permissions settings, such as Add override. Keep @everyone unchanged. It is the name of the role that includes all members. {actor} is the member who made the change, shown as a clickable user chip, or the word System. {channel} is the channel, shown as a channel chip with its name.
#: src/features/guild/utils/guild_tabs/audit_log/AuditLogChannelMessages.ts
msgid "{actor} added a permission override for @everyone in {channel}"
msgstr "{actor} li pana e ken namako tawa @everyone lon {channel}"

#. Activity log summary when a channel got a permission override for a role. A permission override is a channel-level exception to the permissions of a role or member. It allows or denies chosen permissions in one channel or category only. Use the same word for override as the channel permissions settings, such as Add override. {actor} is the member who made the change, shown as a clickable user chip, or the word System. {role} is the role, shown as a role chip with its name. {channel} is the channel, shown as a channel chip with its name.
#: src/features/guild/utils/guild_tabs/audit_log/AuditLogChannelMessages.ts
msgid "{actor} added a permission override for the role {role} in {channel}"
msgstr "{actor} li pana e ken namako tawa poki jan {role} lon {channel}"

#. Activity log summary for a sticker that was added to the community when its name was not recorded. {actor} is the member who added it, shown as a clickable user chip, or the word System.
#: src/features/guild/utils/guild_tabs/audit_log/AuditLogExpressionMessageMessages.ts
msgid "{actor} added a sticker"
msgstr "{actor} li pana e sitelen lipu sin"

#. Activity log summary for a custom emoji that was added to the community when its name was not recorded. {actor} is the member who added it, shown as a clickable user chip, or the word System.
#: src/features/guild/utils/guild_tabs/audit_log/AuditLogExpressionMessageMessages.ts
msgid "{actor} added an emoji"
msgstr "{actor} li pana e sitelen pilin sin"

#. Activity log summary for a bot that was added to the community. {actor} is the member who added the bot, shown as a clickable user chip, or the word System. {target} is the bot, shown as a clickable user chip.
#: src/features/guild/utils/guild_tabs/audit_log/AuditLogMemberMessages.ts
msgid "{actor} added the bot {target}"
msgstr "{actor} li kama e jan ilo {target}"

#. Activity log summary for a bot that was added to the community with temporary membership. {actor} is the member who added the bot, shown as a clickable user chip, or the word System. {target} is the bot, shown as a clickable user chip.
#: src/features/guild/utils/guild_tabs/audit_log/AuditLogMemberMessages.ts
msgid "{actor} added the bot {target} as a temporary member"
msgstr "{actor} li kama e jan ilo {target} lon tenpo lili"

#. Activity log summary for a custom emoji that was uploaded or copied to the community. {actor} is the member who added it, shown as a clickable user chip, or the word System. {emoji} is the emoji, shown as its image when it still exists, followed by its name between colons, for example :blobcat:.
#: src/features/guild/utils/guild_tabs/audit_log/AuditLogExpressionMessageMessages.ts
msgid "{actor} added the emoji {emoji}"
msgstr "{actor} li pana e sitelen pilin {emoji}"

#. Activity log summary for a sticker that was uploaded or copied to the community. {actor} is the member who added it, shown as a clickable user chip, or the word System. {name} is the sticker name, shown in bold. The app adds the bold, so do not add ** or <b>.
#: src/features/guild/utils/guild_tabs/audit_log/AuditLogExpressionMessageMessages.ts
msgid "{actor} added the sticker {name}"
msgstr "{actor} li pana e sitelen lipu {name}"

#. Activity log summary for a user who was banned from the community with no end date. A ban removes the user from the community and stops them from joining again. It is not the feature that blocks a user. {actor} is the member who made the ban, shown as a clickable user chip, or the word System. {target} is the banned user, shown as a clickable user chip.
#: src/features/guild/utils/guild_tabs/audit_log/AuditLogMemberMessages.ts
msgid "{actor} banned {target}"
msgstr "{actor} li weka e {target} tan kulupu lon tenpo ale"

#. Activity log summary for a user who was banned from the community for a limited time. A ban removes the user from the community and stops them from joining again. It is not the feature that blocks a user. {actor} is the member who made the ban, shown as a clickable user chip, or the word System. {target} is the banned user, shown as a clickable user chip. {duration} is how long the ban lasts, shown as a formatted duration phrase such as "3 days" or "12 hours".
#: src/features/guild/utils/guild_tabs/audit_log/AuditLogMemberMessages.ts
msgid "{actor} banned {target} for {duration}"
msgstr "{actor} li weka e {target} tan kulupu lon tenpo {duration}"

#. Activity log summary for a block on a member that was already running and was given a new end. The block stops the member from sending messages, reacting and joining voice, and it lifts on its own at the new end. Spell the effect out the way the English does. Do not name it with a word for a ban, a kick, a mute, a suspension or a waiting period, and do not say that time ran out. Keep the three things that are blocked. This is a past tense record of an action that already happened, never an instruction to the reader. {actor} is the member who moved the end of the block, shown as a clickable user chip, or the word System. {target} is the blocked member, shown as a clickable user chip. {date} is the new end of the block, shown as a formatted date and time.
#: src/features/guild/utils/guild_tabs/audit_log/AuditLogMemberMessages.ts
msgid "{actor} changed {target}'s block on sending messages, reacting and joining voice to end at {date}"
msgstr "{actor} li ante e pini toki pi {target}. ona li pini lon {date}"

#. Activity log summary for a nickname that someone changed for another member in the community. {actor} is the member who changed the nickname, shown as a clickable user chip, or the word System. {target} is the member whose nickname changed, shown as a clickable user chip. {oldNick} is the previous nickname and {newNick} is the new nickname. Keep {oldNick} as the old value and {newNick} as the new value. The app shows both in bold, so do not add ** or <b>.
#: src/features/guild/utils/guild_tabs/audit_log/AuditLogMemberMessages.ts
msgid "{actor} changed the nickname of {target} from {oldNick} to {newNick}"
msgstr "{actor} li ante e nimi lon kulupu pi {target} tan {oldNick} tawa {newNick}"

#. Activity log summary for an older entry that only recorded that the permission overrides of an announcement channel were changed, without saying which. A permission override is a channel-level exception to the permissions of a role or member. It allows or denies chosen permissions in one channel or category only. Use the same word for override as the channel permissions settings, such as Add override. {actor} is the member who made the change, shown as a clickable user chip, or the word System. {channel} is the channel, shown as a channel chip with its name.
#: src/features/guild/utils/guild_tabs/audit_log/AuditLogChannelMessages.ts
msgid "{actor} changed the permission overrides of the announcement channel {channel}"
msgstr "{actor} li ante e ken namako pi tomo pi toki suli {channel}"

#. Activity log summary for an older entry that only recorded that the permission overrides of a channel category were changed, without saying which. A permission override is a channel-level exception to the permissions of a role or member. It allows or denies chosen permissions in one channel or category only. Use the same word for override as the channel permissions settings, such as Add override. {actor} is the member who made the change, shown as a clickable user chip, or the word System. {channel} is the category, shown as a channel chip with its name.
#: src/features/guild/utils/guild_tabs/audit_log/AuditLogChannelMessages.ts
msgid "{actor} changed the permission overrides of the category {channel}"
msgstr "{actor} li ante e ken namako pi kulupu tomo {channel}"

#. Activity log summary for an older entry that only recorded that the permission overrides of a channel of a type this app version cannot name were changed, without saying which. A permission override is a channel-level exception to the permissions of a role or member. It allows or denies chosen permissions in one channel or category only. Use the same word for override as the channel permissions settings, such as Add override. {actor} is the member who made the change, shown as a clickable user chip, or the word System. {channel} is the channel, shown as a channel chip with its name.
#: src/features/guild/utils/guild_tabs/audit_log/AuditLogChannelMessages.ts
msgid "{actor} changed the permission overrides of the channel {channel}"
msgstr "{actor} li ante e ken namako pi tomo {channel}"

#. Activity log summary for an entry that only recorded that the permission overrides of a forum channel were changed. {channel} is shown as a channel chip.
#: src/features/guild/utils/guild_tabs/audit_log/AuditLogForumPresentation.ts
msgid "{actor} changed the permission overrides of the forum channel {channel}"
msgstr "{actor} li ante e ken namako pi tomo pi linja toki {channel}"

#. Activity log summary for an older entry that only recorded that the permission overrides of a link channel were changed, without saying which. A link channel is a channel list entry that opens a web address. A permission override is a channel-level exception to the permissions of a role or member. It allows or denies chosen permissions in one channel or category only. Use the same word for override as the channel permissions settings, such as Add override. {actor} is the member who made the change, shown as a clickable user chip, or the word System. {channel} is the channel, shown as a channel chip with its name.
#: src/features/guild/utils/guild_tabs/audit_log/AuditLogChannelMessages.ts
msgid "{actor} changed the permission overrides of the link channel {channel}"
msgstr "{actor} li ante e ken namako pi tomo linja {channel}"

#. Activity log summary for an entry that only recorded that the permission overrides of a media channel were changed. {channel} is shown as a channel chip.
#: src/features/guild/utils/guild_tabs/audit_log/AuditLogForumPresentation.ts
msgid "{actor} changed the permission overrides of the media channel {channel}"
msgstr "{actor} li ante e ken namako pi tomo sitelen tawa {channel}"

#. Activity log summary for an older entry that only recorded that the permission overrides of a text channel were changed, without saying which. A permission override is a channel-level exception to the permissions of a role or member. It allows or denies chosen permissions in one channel or category only. Use the same word for override as the channel permissions settings, such as Add override. {actor} is the member who made the change, shown as a clickable user chip, or the word System. {channel} is the channel, shown as a channel chip with its name.
#: src/features/guild/utils/guild_tabs/audit_log/AuditLogChannelMessages.ts
msgid "{actor} changed the permission overrides of the text channel {channel}"
msgstr "{actor} li ante e ken namako pi tomo sitelen {channel}"

#. Activity log summary for an older entry that only recorded that the permission overrides of a voice channel were changed, without saying which. A permission override is a channel-level exception to the permissions of a role or member. It allows or denies chosen permissions in one channel or category only. Use the same word for override as the channel permissions settings, such as Add override. {actor} is the member who made the change, shown as a clickable user chip, or the word System. {channel} is the channel, shown as a channel chip with its name.
#: src/features/guild/utils/guild_tabs/audit_log/AuditLogChannelMessages.ts
msgid "{actor} changed the permission overrides of the voice channel {channel}"
msgstr "{actor} li ante e ken namako pi tomo kalama {channel}"

#. Activity log summary when a member replaced the vanity URL, the custom invite link of the community. {actor} is the member who made the change, shown as a clickable user chip, or the word System. {oldCode} is the previous vanity URL code and {newCode} is the new vanity URL code, both shown as boxed text.
#: src/features/guild/utils/guild_tabs/audit_log/AuditLogGuildMessages.ts
msgid "{actor} changed the vanity URL from {oldCode} to {newCode}"
msgstr "{actor} li ante e linja kama pi nimi kulupu tan {oldCode} tawa {newCode}"

#. Activity log summary for a member who replaced the avatar on their community profile. A community profile is the profile a member uses only in this community, in place of their global profile. The avatar belongs to the member, not to the community. "Their" means the same member as {actor}. {actor} is that member, shown as a clickable user chip.
#: src/features/guild/utils/guild_tabs/audit_log/AuditLogMemberMessages.ts
msgid "{actor} changed their community profile avatar"
msgstr "{actor} li ante e sitelen jan ona lon lipu lukin pi kulupu ni"

#. Activity log summary for a member who replaced the banner image on their community profile. A community profile is the profile a member uses only in this community, in place of their global profile. The banner belongs to the member, not to the community. "Their" means the same member as {actor}. {actor} is that member, shown as a clickable user chip.
#: src/features/guild/utils/guild_tabs/audit_log/AuditLogMemberMessages.ts
msgid "{actor} changed their community profile banner"
msgstr "{actor} li ante e sitelen suli ona lon lipu lukin pi kulupu ni"

#. Activity log summary for a member who changed the bio on their community profile. A community profile is the profile a member uses only in this community, in place of their global profile. The bio belongs to the member, not to the community. "Their" means the same member as {actor}. {actor} is that member, shown as a clickable user chip. {text} is the new bio, shown as boxed text and shortened when long.
#: src/features/guild/utils/guild_tabs/audit_log/AuditLogMemberMessages.ts
msgid "{actor} changed their community profile bio to {text}"
msgstr "{actor} li ante e toki sona ona lon lipu lukin pi kulupu ni. toki sin li {text}"

#. Activity log summary for a member who changed their own nickname in the community. "Their" means the same member as {actor}. {actor} is that member, shown as a clickable user chip. {oldNick} is the previous nickname and {newNick} is the new nickname. Keep {oldNick} as the old value and {newNick} as the new value. The app shows both in bold, so do not add ** or <b>.
#: src/features/guild/utils/guild_tabs/audit_log/AuditLogMemberMessages.ts
msgid "{actor} changed their nickname from {oldNick} to {newNick}"
msgstr "{actor} li ante e nimi ona lon kulupu tan {oldNick} tawa {newNick}"

#. Activity log summary for a new webhook when its name was not recorded. {actor} is the member who created the webhook, shown as a clickable user chip, or the word System.
#: src/features/guild/utils/guild_tabs/audit_log/AuditLogInviteWebhookMessages.ts
msgid "{actor} created a webhook"
msgstr "{actor} li pali e ilo Webhook sin"

#. Activity log summary when an announcement channel was created. {actor} is the member who made the change, shown as a clickable user chip, or the word System. {channel} is the new channel, shown as a channel chip with its name.
#: src/features/guild/utils/guild_tabs/audit_log/AuditLogChannelMessages.ts
msgid "{actor} created the announcement channel {channel}"
msgstr "{actor} li open e tomo pi toki suli {channel}"

#. Activity log summary when an announcement channel was created inside a category. {actor} is the member who made the change, shown as a clickable user chip, or the word System. {channel} is the new channel, shown as a channel chip with its name. {category} is the category that holds it, shown as a channel chip with its name.
#: src/features/guild/utils/guild_tabs/audit_log/AuditLogChannelMessages.ts
msgid "{actor} created the announcement channel {channel} in {category}"
msgstr "{actor} li open e tomo pi toki suli {channel} lon kulupu tomo {category}"

#. Activity log summary when a channel category was created. {actor} is the member who made the change, shown as a clickable user chip, or the word System. {channel} is the new category, shown as a channel chip with its name.
#: src/features/guild/utils/guild_tabs/audit_log/AuditLogChannelMessages.ts
msgid "{actor} created the category {channel}"
msgstr "{actor} li open e kulupu tomo {channel}"

#. Activity log summary when a channel of a type this app version cannot name was created. {actor} is the member who made the change, shown as a clickable user chip, or the word System. {channel} is the new channel, shown as a channel chip with its name.
#: src/features/guild/utils/guild_tabs/audit_log/AuditLogChannelMessages.ts
msgid "{actor} created the channel {channel}"
msgstr "{actor} li open e tomo {channel}"

#. Activity log summary when a channel of a type this app version cannot name was created inside a category. {actor} is the member who made the change, shown as a clickable user chip, or the word System. {channel} is the new channel, shown as a channel chip with its name. {category} is the category that holds it, shown as a channel chip with its name.
#: src/features/guild/utils/guild_tabs/audit_log/AuditLogChannelMessages.ts
msgid "{actor} created the channel {channel} in {category}"
msgstr "{actor} li open e tomo {channel} lon kulupu tomo {category}"

#. Activity log summary when a forum channel was created. {actor} is the member who made the change, shown as a clickable user chip, or the word System. {channel} is the new channel, shown as a channel chip with its name.
#: src/features/guild/utils/guild_tabs/audit_log/AuditLogForumPresentation.ts
msgid "{actor} created the forum channel {channel}"
msgstr "{actor} li open e tomo pi linja toki {channel}"

#. Activity log summary when a forum channel was created inside a category. {actor} is the member who made the change. {channel} is the new channel and {category} the category that holds it, both shown as channel chips.
#: src/features/guild/utils/guild_tabs/audit_log/AuditLogForumPresentation.ts
msgid "{actor} created the forum channel {channel} in {category}"
msgstr "{actor} li open e tomo pi linja toki {channel} lon kulupu tomo {category}"

#. Activity log summary for a new invite link when its channel was not recorded. {actor} is the member who created the invite, shown as a clickable user chip, or the word System. {code} is the invite code, shown as boxed text.
#: src/features/guild/utils/guild_tabs/audit_log/AuditLogInviteWebhookMessages.ts
msgid "{actor} created the invite {code}"
msgstr "{actor} li pali e linja kama {code}"

#. Activity log summary for a new invite link. {actor} is the member who created the invite, shown as a clickable user chip, or the word System. {code} is the invite code, shown as boxed text. {channel} is the channel the invite leads to, shown as a channel chip.
#: src/features/guild/utils/guild_tabs/audit_log/AuditLogInviteWebhookMessages.ts
msgid "{actor} created the invite {code} for {channel}"
msgstr "{actor} li pali e linja kama {code} tawa {channel}"

#. Activity log summary when a link channel was created. A link channel is a channel list entry that opens a web address. {actor} is the member who made the change, shown as a clickable user chip, or the word System. {channel} is the new channel, shown as a channel chip with its name.
#: src/features/guild/utils/guild_tabs/audit_log/AuditLogChannelMessages.ts
msgid "{actor} created the link channel {channel}"
msgstr "{actor} li open e tomo linja {channel}"

#. Activity log summary when a link channel was created inside a category. A link channel is a channel list entry that opens a web address. {actor} is the member who made the change, shown as a clickable user chip, or the word System. {channel} is the new channel, shown as a channel chip with its name. {category} is the category that holds it, shown as a channel chip with its name.
#: src/features/guild/utils/guild_tabs/audit_log/AuditLogChannelMessages.ts
msgid "{actor} created the link channel {channel} in {category}"
msgstr "{actor} li open e tomo linja {channel} lon kulupu tomo {category}"

#. Activity log summary when a media channel was created. {actor} is the member who made the change, shown as a clickable user chip, or the word System. {channel} is the new channel, shown as a channel chip with its name.
#: src/features/guild/utils/guild_tabs/audit_log/AuditLogForumPresentation.ts
msgid "{actor} created the media channel {channel}"
msgstr "{actor} li open e tomo sitelen tawa {channel}"

#. Activity log summary when a media channel was created inside a category. {actor} is the member who made the change. {channel} is the new channel and {category} the category that holds it, both shown as channel chips.
#: src/features/guild/utils/guild_tabs/audit_log/AuditLogForumPresentation.ts
msgid "{actor} created the media channel {channel} in {category}"
msgstr "{actor} li open e tomo sitelen tawa {channel} lon kulupu tomo {category}"

#. Activity log summary for a role that was created in the community. {actor} is the member who created it, shown as a clickable user chip, or the word System. {role} is the new role, shown in bold with its name, or deleted-role when its name is unknown. The app adds the bold, so do not add ** or <b>. Use the same word for role as the rest of the app.
#: src/features/guild/utils/guild_tabs/audit_log/AuditLogRoleMessages.ts
msgid "{actor} created the role {role}"
msgstr "{actor} li pali e poki jan {role}"

#. Activity log summary when a text channel was created. {actor} is the member who made the change, shown as a clickable user chip, or the word System. {channel} is the new channel, shown as a channel chip with its name.
#: src/features/guild/utils/guild_tabs/audit_log/AuditLogChannelMessages.ts
msgid "{actor} created the text channel {channel}"
msgstr "{actor} li open e tomo sitelen {channel}"

#. Activity log summary when a text channel was created inside a category. {actor} is the member who made the change, shown as a clickable user chip, or the word System. {channel} is the new channel, shown as a channel chip with its name. {category} is the category that holds it, shown as a channel chip with its name.
#: src/features/guild/utils/guild_tabs/audit_log/AuditLogChannelMessages.ts
msgid "{actor} created the text channel {channel} in {category}"
msgstr "{actor} li open e tomo sitelen {channel} lon kulupu tomo {category}"

#. Activity log summary when a voice channel was created. {actor} is the member who made the change, shown as a clickable user chip, or the word System. {channel} is the new channel, shown as a channel chip with its name.
#: src/features/guild/utils/guild_tabs/audit_log/AuditLogChannelMessages.ts
msgid "{actor} created the voice channel {channel}"
msgstr "{actor} li open e tomo kalama {channel}"

#. Activity log summary when a voice channel was created inside a category. {actor} is the member who made the change, shown as a clickable user chip, or the word System. {channel} is the new channel, shown as a channel chip with its name. {category} is the category that holds it, shown as a channel chip with its name.
#: src/features/guild/utils/guild_tabs/audit_log/AuditLogChannelMessages.ts
msgid "{actor} created the voice channel {channel} in {category}"
msgstr "{actor} li open e tomo kalama {channel} lon kulupu tomo {category}"

#. Activity log summary for a new webhook when its channel was not recorded. {actor} is the member who created the webhook, shown as a clickable user chip, or the word System. {name} is the name of the webhook, shown in bold by the app. Do not add ** or <b> around it.
#: src/features/guild/utils/guild_tabs/audit_log/AuditLogInviteWebhookMessages.ts
