#: src/features/guild/utils/guild_tabs/audit_log/AuditLogChannelMessages.ts:153
msgid "{actor} changed the permission overrides of the channel {channel}"
msgstr "{actor} đã thay đổi quyền ghi đè của kênh {channel}"

