msgid "Your profile privacy is limited, so some people still won't see this connection even when Everyone is enabled."
msgstr "Súkromie tvojho profilu je obmedzené, takže niektorí ľudia toto prepojenie neuvidia, ani keď je zapnutá možnosť Všetci."

#. SSO callback page error shown when the sign-in provider asks the person to sign in or give consent again.
#: src/features/auth/components/pages/SsoCallbackPage.tsx
msgid "Your provider needs you to sign in again."
msgstr "Tvoj poskytovateľ vyžaduje, aby si sa znova prihlásil."

#. SSO callback page error shown when the sign-in provider sent back any other error.
#: src/features/auth/components/pages/SsoCallbackPage.tsx
msgid "Your provider reported an error."
msgstr "Tvoj poskytovateľ nahlásil chybu."

#. Settings search entry label. Names the settings search entry in the settings UI.
#: src/features/user/components/settings_utils/search_index/GiftInventoryIndex.ts
