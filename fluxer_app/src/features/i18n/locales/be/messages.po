msgstr "Не ўдалося выдаліць паведамленне"

#. Error message in the search result open failed modal.
#: src/features/search/components/alerts/SearchResultOpenFailedModal.tsx
msgid "That message is gone, or you lost access to the conversation."
msgstr "Гэта паведамленне знікла, або вы страцілі доступ да размовы."

#. Error under the setup token field when the token is wrong.
#: src/features/app/components/setup/SetupTokenStep.tsx
msgid "That setup token doesn't match. Check that you copied all of it."
msgstr "Гэты токен наладкі не падыходзіць. Праверце, ці скапіравалі вы яго цалкам."

