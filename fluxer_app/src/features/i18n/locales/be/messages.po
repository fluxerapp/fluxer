#. SSO callback page error shown when the sign-in provider sent back any other error.
#: src/features/auth/components/pages/SsoCallbackPage.tsx
msgid "Your provider reported an error."
msgstr "Ваш пастаўшчык паведаміў пра памылку."

#. Settings search entry label. Names the settings search entry in the settings UI.
#: src/features/user/components/settings_utils/search_index/GiftInventoryIndex.ts
