#. Problem shown in the quick CSS editor on var() of a CSS variable that does not exist. {name} is the variable name without its leading dashes.
#: src/features/theme_settings/editor/CssLint.ts
msgid "--{name} isn't a Fluxer variable and isn't set anywhere in your CSS."
msgstr "--{name} কোনো Fluxer ভেরিয়েবল নয় এবং আপনার CSS-এ কোথাও সেট করা হয়নি।"

#. Description text in the messages tab.
#: src/features/user/components/modals/tabs/appearance_tab/MessagesTab.tsx
msgid "... turn dense mode on. Nice!"
msgstr "… ডেন্স মোড চালু করুন। দারুণ!"

#. Error at the bottom of the setup wizard branding step when an uploaded image could not be loaded from the server. label is the name of the image field, such as Sign-in background.
#: src/features/app/components/setup/SetupBrandingStep.tsx
msgid "\"{label}\" was saved but could not be loaded back."
msgstr "“{label}” সেভ হয়েছে, কিন্তু আবার লোড করা যায়নি।"

