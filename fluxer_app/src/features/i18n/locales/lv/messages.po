#. Line naming a Plutonium subscription the buyer can withdraw from, shown in settings and in the withdrawal dialog. This is the statutory line naming the contract, required for the withdrawal function by EU consumer law (Directive 2023/2673, article 11a) and in Sweden by distansavtalslagen 2 kap. 10 a §. {premiumProductName} is the plan name, such as Plutonium, keep it as is. {date} is the date of the payment that started the withdrawal period, the first payment or a renewal, such as Dec 4, 2026.
#: src/features/premium/components/operator_pass/OperatorPassWithdrawModal.tsx
msgid "{premiumProductName} subscription, paid on {date}."
msgstr "{premiumProductName} abonements, apmaksāts {date}."

#. Short label in the guild header bottom sheet. Keep it concise. Preserve {presenceCount}; it is inserted by code.
#: src/features/guild/components/bottomsheets/GuildHeaderBottomSheet.tsx
msgid "{presenceCount} online"
msgstr "Tiešsaistē: {presenceCount}"

#: src/features/auth/state/NewDeviceMonitoring.tsx
msgid "{PRODUCT_NAME} has found a new audio device called <0>{deviceName}</0>. Do you want to switch to it?"
msgstr "Lietotne {PRODUCT_NAME} atrada jaunu audio ierīci <0>{deviceName}</0>. Vai vēlies pārslēgties uz to?"

#: src/features/auth/state/NewDeviceMonitoring.tsx
msgid "{PRODUCT_NAME} has found a new audio input device called <0>{deviceName}</0>. Do you want to switch to it?"
msgstr "Lietotne {PRODUCT_NAME} atrada jaunu audio ievades ierīci <0>{deviceName}</0>. Vai vēlies pārslēgties uz to?"

#: src/features/auth/state/NewDeviceMonitoring.tsx
msgid "{PRODUCT_NAME} has found a new audio output device called <0>{deviceName}</0>. Do you want to switch to it?"
msgstr "Lietotne {PRODUCT_NAME} atrada jaunu audio izvades ierīci <0>{deviceName}</0>. Vai vēlies pārslēgties uz to?"

#: src/features/user/components/modals/tabs/advanced_settings_tab/AdvancedAccessibilityControls.tsx
msgid "{PRODUCT_NAME} needs to restart before Chromium's native scrolling settings change how scrolling works."
msgstr "Lietotne {PRODUCT_NAME} jārestartē, lai Chromium iebūvētās ritināšanas iestatījumi mainītu ritināšanu."

#: src/features/user/components/modals/tabs/advanced_settings_tab/AdvancedDesktopControls.tsx
msgid "{PRODUCT_NAME} needs to restart for hardware acceleration to take effect."
msgstr "Lietotne {PRODUCT_NAME} jārestartē, lai stātos spēkā aparatūras paātrinājums."

#: src/features/user/components/modals/tabs/advanced_settings_tab/AdvancedDesktopControls.tsx
msgid "{PRODUCT_NAME} needs to restart for the title bar change to take effect."
msgstr "Lietotne {PRODUCT_NAME} jārestartē, lai stātos spēkā virsrakstjoslas izmaiņas."

#: src/features/user/components/modals/tabs/advanced_settings_tab/AdvancedDesktopControls.tsx
msgid "{PRODUCT_NAME} needs to restart to disable Chromium's hardware acceleration. Use this only if you're troubleshooting graphics glitches or high GPU usage."
msgstr "Lietotne {PRODUCT_NAME} jārestartē, lai atspējotu Chromium aparatūras paātrinājumu. Izmanto to tikai tad, ja novērs grafikas kļūmes vai lielu GPU noslodzi."

#: src/features/user/components/modals/tabs/advanced_settings_tab/AdvancedDesktopControls.tsx
msgid "{PRODUCT_NAME} needs to restart to install updates automatically again."
msgstr "Lietotne {PRODUCT_NAME} jārestartē, lai atkal automātiski instalētu atjauninājumus."

#: src/features/user/components/modals/tabs/advanced_settings_tab/AdvancedDesktopControls.tsx
msgid "{PRODUCT_NAME} needs to restart to stop updating while starting. When an update is available, you can install it from the app whenever you like."
msgstr "Lietotne {PRODUCT_NAME} jārestartē, lai tā vairs neatjauninātos palaišanas laikā. Kad būs pieejams atjauninājums, varēsi to instalēt no lietotnes, kad vien vēlies."

#. Desktop updater modal body for a Flatpak install when a newer desktop version exists. The version placeholder is the new app version and productName is the app name.
#: src/features/updater/commands/UpdaterModalCommands.tsx
msgid "{productName} {version} is available. Update it from your software center."
msgstr "Pieejama lietotnes {productName} versija {version}. Atjaunini to programmatūras centrā."

#. Desktop updater modal body for a Linux install managed by a package manager, such as a deb, rpm or AUR package, when a newer desktop version exists. The version placeholder is the new app version and productName is the app name.
#: src/features/updater/commands/UpdaterModalCommands.tsx
msgid "{productName} {version} is available. Update it with your package manager, or download the new version."
msgstr "Pieejama lietotnes {productName} versija {version}. Atjaunini to ar pakotņu pārvaldnieku vai lejupielādē jauno versiju."

#. Accessible label for the Fluxer application icon.
#: src/features/ui/components/icons/FluxerIconMark.tsx
msgid "{productName} application icon"
msgstr "Lietotnes {productName} ikona"

#. Label in the push settings.
#: src/features/user/components/modals/tabs/notifications_tab/PushSettings.tsx
msgid "{productName} avoids sending push notifications to your mobile devices when you are at your computer. Choose how long you need to be inactive on desktop before you receive push notifications."
msgstr "Lietotne {productName} nesūta push paziņojumus uz tavām mobilajām ierīcēm, kamēr esi pie datora. Izvēlies, cik ilgi jābūt neaktīvam datorā, pirms saņem push paziņojumus."

#. First sentence of the network blocked screen when a rule is shown. productName is the app name. Must read the same as the error message for this block.
#: src/features/auth/AuthMessageDescriptors.ts
msgid "{productName} blocked access from this network because of activity that broke its rules."
msgstr "{productName} bloķēja piekļuvi no šī tīkla darbību dēļ, kas pārkāpa tā noteikumus."

#. First sentence of the network blocked screen when no rule is shown. productName is the app name. Must read the same as the error message for this block.
#: src/features/auth/AuthMessageDescriptors.ts
msgid "{productName} blocked access from this network."
msgstr "{productName} bloķēja piekļuvi no šī tīkla."

#. Linux settings text before system-wide shortcuts are set up. The desktop environment owns the keys. {productName} is the app name.
#: src/features/user/components/modals/tabs/components/SystemShortcutsSection.tsx
msgid "{productName} can ask your desktop to run its keybinds while {productName} is not focused. Your desktop asks you to confirm and lets you pick the keys."
msgstr "Lietotne {productName} var lūgt tavai darbvirsmai izpildīt tās īsinājumtaustiņus, kad {productName} nav fokusā. Darbvirsma lūgs tev to apstiprināt un ļaus izvēlēties taustiņus."

#. Description for the Linux direct input device access switch when it is on but the keyboard can no longer be read, on an X11 session. The app now listens for shortcuts through the X11 display server itself. Keep "X11" as written. {productName} is the app name.
#: src/features/user/components/modals/tabs/components/SystemShortcutsSection.tsx
msgid "{productName} can no longer read your keyboard, so it listens for keybinds through X11 instead."
msgstr "Lietotne {productName} vairs nevar nolasīt tavu tastatūru, tāpēc īsinājumtaustiņus tā uztver caur X11."

#. Description for the Linux direct input device access switch when it is on but the keyboard can no longer be read, for example after a restart removed the access. The app already falls back to the shortcuts the desktop runs. {productName} is the app name.
#: src/features/user/components/modals/tabs/components/SystemShortcutsSection.tsx
msgid "{productName} can no longer read your keyboard, so your desktop's keybinds are used instead."
msgstr "Lietotne {productName} vairs nevar nolasīt tavu tastatūru, tāpēc tiek izmantoti tavas darbvirsmas īsinājumtaustiņi."

#. Description for the Linux direct input device access switch when it is on but the keyboard can no longer be read and nothing else runs system-wide shortcuts. {productName} is the app name.
#: src/features/user/components/modals/tabs/components/SystemShortcutsSection.tsx
msgid "{productName} can no longer read your keyboard. Keybinds only work while {productName} is focused."
msgstr "Lietotne {productName} vairs nevar nolasīt tavu tastatūru. Īsinājumtaustiņi darbojas tikai tad, kad {productName} ir fokusā."

#. Linux settings text before system-wide shortcuts are set up on the Hyprland desktop. Hyprland shows no dialog. The config is hyprland.lua on Hyprland 0.55 and later, hyprland.conf before. {productName} is the app name.
#: src/features/user/components/modals/tabs/components/SystemShortcutsSection.tsx
msgid "{productName} can register its keybinds with Hyprland so they run while {productName} is not focused. You then bind the keys in your Hyprland config."
msgstr "Lietotne {productName} var reģistrēt savus īsinājumtaustiņus Hyprland, lai tie darbotos, kad {productName} nav fokusā. Pēc tam piesaisti taustiņus savā Hyprland konfigurācijā."

#. Inline notice body on Windows. Explains that desktop audio is disabled because productName cannot exclude its own WebRTC/call playback on this OS build.
#: src/features/voice/utils/VoiceSharedMessageDescriptors.ts
msgid "{productName} cannot capture desktop audio here while excluding {productName}'s call audio."
msgstr "Lietotne {productName} šeit nevar ierakstīt darbvirsmas skaņu, neiekļaujot lietotnes {productName} zvana skaņu."

#. Inline notice body on Windows. Explains that app audio is disabled because productName cannot guarantee isolated audio capture on this OS build.
#: src/features/voice/utils/VoiceSharedMessageDescriptors.ts
msgid "{productName} cannot capture only one app's audio here without risking unrelated app audio or call audio."
msgstr "Lietotne {productName} šeit nevar ierakstīt tikai vienas lietotnes skaņu, neriskējot iekļaut citu lietotņu vai zvana skaņu."

#. Inline notice body on Linux when desktop audio capture is unavailable.
#: src/features/voice/components/modals/screen_share_picker_modal/PerWindowAudioNotice.tsx
msgid "{productName} cannot start a safe desktop audio route while excluding {productName}'s call audio."
msgstr "Lietotne {productName} nevar droši ierakstīt darbvirsmas skaņu, neiekļaujot lietotnes {productName} zvana skaņu."

#. Inline notice body on Linux when isolated per-app audio capture is unavailable.
#: src/features/voice/components/modals/screen_share_picker_modal/PerWindowAudioNotice.tsx
msgid "{productName} cannot start a safe isolated route for this app's audio."
msgstr "Lietotne {productName} nevar droši un atsevišķi ierakstīt šīs lietotnes skaņu."

#. Modal body shown when a user-initiated update check fails. productName is the app name.
#: src/features/updater/commands/UpdaterModalCommands.tsx
msgid "{productName} could not connect to the update service. Check your connection and try again."
msgstr "Lietotne {productName} nevarēja izveidot savienojumu ar atjaunināšanas pakalpojumu. Pārbaudi savienojumu un mēģini vēlreiz."

#. Invite page notice shown when automated raid protection pauses invites. productName is the Fluxer product name.
#: src/features/invite/utils/InviteMessageDescriptors.ts
msgid "{productName} detected a potential raid in this community, so invites are paused."
msgstr "{productName} šajā kopienā konstatēja iespējamu reidu, tāpēc uzaicinājumi ir apturēti."

#. Invite modal notice shown when automated raid protection pauses invites. productName is the Fluxer product name.
#: src/features/invite/utils/InviteMessageDescriptors.ts
msgid "{productName} detected a potential raid in this community. Invites are paused, so new users cannot join right now."
msgstr "{productName} šajā kopienā konstatēja iespējamu reidu. Uzaicinājumi ir apturēti, tāpēc jauni lietotāji pašlaik nevar pievienoties."

#. Anti-raid status message on a community invite embed. productName is the product brand name placeholder.
#: src/features/channel/components/InviteEmbed.tsx
msgid "{productName} detected a potential raid, so new users can't join right now."
msgstr "{productName} konstatēja iespējamu reidu, tāpēc jauni lietotāji pašlaik nevar pievienoties."

#: src/features/app/components/BootstrapErrorScreen.tsx
msgid "{productName} failed to start properly. This could be due to corrupted data or a temporary issue."
msgstr "Lietotni {productName} neizdevās pareizi palaist. Iemesls var būt bojāti dati vai īslaicīga problēma."

#. Banner in a web app installed on iPhone, iPad or Mac. productName is the app name. host is the new domain, for example fluxer.com. Home Screen and Dock are Apple names.
#: src/features/app/components/layout/app_layout/nagbars/DomainMovedNagbar.tsx
msgid "{productName} has moved to {host}. Add it to your Home Screen or Dock, then sign in with this app."
msgstr "{productName} ir pārcēlies uz {host}. Pievieno to sākuma ekrānam vai Dock joslai un pēc tam pieraksties ar šo lietotni."

#. Banner in an installed web app on other browsers. productName is the app name. host is the new domain, for example fluxer.com.
#: src/features/app/components/layout/app_layout/nagbars/DomainMovedNagbar.tsx
msgid "{productName} has moved to {host}. Install it from your browser, then sign in with this app."
msgstr "{productName} ir pārcēlies uz {host}. Instalē to no pārlūka un pēc tam pieraksties ar šo lietotni."

#. Banner in an installed desktop web app after the account moved to the new domain. productName is the app name. host is the new domain, for example fluxer.com.
#: src/features/app/components/layout/app_layout/nagbars/DomainMovedNagbar.tsx
msgid "{productName} has moved to {host}. Install the new app and you will already be signed in."
msgstr "{productName} ir pārcēlies uz {host}. Instalē jauno lietotni, un tu jau būsi pierakstījies."

#. Banner in an installed Android web app. productName is the app name. host is the new domain, for example fluxer.com.
#: src/features/app/components/layout/app_layout/nagbars/DomainMovedNagbar.tsx
msgid "{productName} has moved to {host}. Open it in your browser to install the new app."
msgstr "{productName} ir pārcēlies uz {host}. Atver to pārlūkā, lai instalētu jauno lietotni."

#. Intro in the modal that explains how to install the app from its new domain. productName is the app name. host is the new domain, for example fluxer.com.
#: src/features/app/domain_migration/DomainMovedStepsModal.tsx
msgid "{productName} is now at {host}. Install it from there, then sign in with this app."
msgstr "{productName} tagad atrodas {host}. Instalē to no turienes un pēc tam pieraksties ar šo lietotni."

#. Intro in the modal that explains how to install the app from its new domain when the account already moved. productName is the app name. host is the new domain, for example fluxer.com.
#: src/features/app/domain_migration/DomainMovedStepsModal.tsx
msgid "{productName} is now at {host}. Install it from there."
msgstr "{productName} tagad atrodas {host}. Instalē to no turienes."

#. Profile membership label showing when the user account was created.
#: src/features/user/components/popouts/UserProfileShared.tsx
msgid "{productName} member since"
msgstr "{productName} dalībnieks kopš"

#. Body of the camera-permission-denied modal on web. {productName} is Fluxer.
#: src/features/permissions/system/components/MediaPermissionBlockedModal.tsx
msgid "{productName} needs access to your camera to enable video chat. Grant camera permission in your browser settings and try again."
msgstr "Lietotnei {productName} nepieciešama piekļuve kamerai, lai varētu izmantot videozvanus. Atļauj piekļuvi kamerai pārlūka iestatījumos un mēģini vēlreiz."

#. Body of the camera-permission-denied modal on Windows and Linux. {productName} is Fluxer.
#: src/features/permissions/system/components/MediaPermissionBlockedModal.tsx
msgid "{productName} needs access to your camera. Allow camera access in your operating system privacy settings and restart the app."
msgstr "Lietotnei {productName} nepieciešama piekļuve kamerai. Atļauj piekļuvi kamerai operētājsistēmas privātuma iestatījumos un restartē lietotni."

#. Body of the microphone-permission-denied modal on web. {productName} is Fluxer.
#: src/features/permissions/system/components/MediaPermissionBlockedModal.tsx
msgid "{productName} needs access to your microphone to enable voice chat. Grant microphone permission in your browser settings and try again."
msgstr "Lietotnei {productName} nepieciešama piekļuve mikrofonam, lai varētu izmantot balss zvanus. Atļauj piekļuvi mikrofonam pārlūka iestatījumos un mēģini vēlreiz."

#. Body of the microphone-permission-denied modal on Windows and Linux. {productName} is Fluxer.
#: src/features/permissions/system/components/MediaPermissionBlockedModal.tsx
msgid "{productName} needs access to your microphone. Allow microphone access in your operating system privacy settings and restart the app."
msgstr "Lietotnei {productName} nepieciešama piekļuve mikrofonam. Atļauj piekļuvi mikrofonam operētājsistēmas privātuma iestatījumos un restartē lietotni."

#. Camera settings notice shown when camera permission has not been granted.
#: src/features/user/components/modals/tabs/UserVideoTab.tsx
msgid "{productName} needs camera access to list your devices."
msgstr "Lietotnei {productName} nepieciešama piekļuve kamerai, lai parādītu tavas ierīces."

#. Voice settings notice shown when microphone permission has not been granted.
#: src/features/user/components/modals/tabs/UserVoiceTab.tsx
msgid "{productName} needs microphone access to list your devices."
msgstr "Lietotnei {productName} nepieciešama piekļuve mikrofonam, lai parādītu tavas ierīces."

#. Body of the screen-permission-denied modal on non-mac desktop platforms. {productName} is Fluxer.
#: src/features/permissions/system/components/MediaPermissionBlockedModal.tsx
msgid "{productName} needs screen recording access. Allow screen recording in your operating system privacy settings and restart the app."
msgstr "Lietotnei {productName} nepieciešama piekļuve ekrāna ierakstīšanai. Atļauj ekrāna ierakstīšanu operētājsistēmas privātuma iestatījumos un restartē lietotni."

#. Text under the date of birth heading. productName is the app name. It says the app never asks for ID or a face scan, what the date is used for, and that it cannot be changed once entered.
#: src/features/auth/components/date_of_birth/DateOfBirthGate.tsx
msgid "{productName} only asks for your date of birth, never for ID or a face scan. It's used to check the minimum age for your country and for age-restricted content, and it isn't shown to anyone. You can't change it later, so please make sure it's right."
msgstr "{productName} prasa tikai tavu dzimšanas datumu un nekad neprasa personu apliecinošu dokumentu vai sejas skenēšanu. To izmanto, lai pārbaudītu tavai valstij noteikto minimālo vecumu un vecuma ierobežojumus saturam, un tas netiek nevienam rādīts. Vēlāk to mainīt nevarēs, tāpēc pārliecinies, ka tas ir pareizs."

#. Title of the printed or downloaded recovery kit. productName is the app name.
#: src/features/auth/components/modals/RecoveryKitModal.tsx
msgid "{productName} recovery kit"
msgstr "{productName} atkopšanas komplekts"

#. Subtitle for system-wide shortcuts on the Hyprland desktop after setup. Hyprland shows no list of assigned keys. {productName} is the app name.
#: src/features/user/components/modals/tabs/components/SystemShortcutsSection.tsx
msgid "{productName} registered its keybinds with Hyprland. Bind them in your Hyprland config to use them while {productName} is not focused."
msgstr "Lietotne {productName} reģistrēja savus īsinājumtaustiņus Hyprland. Piesaisti tos savā Hyprland konfigurācijā, lai tos izmantotu, kad {productName} nav fokusā."

#. Desktop updater modal body after a manual update check finds an update to the app files only. Confirming reloads the app window in place without quitting. productName is the app name.
#: src/features/updater/commands/UpdaterModalCommands.tsx
msgid "{productName} reloads to finish updating."
msgstr "Lietotne {productName} tiks pārlādēta, lai pabeigtu atjaunināšanu."

#. Nagbar shown after the app restarts while the user was connected to a community voice channel. {productName} is Fluxer, {channelName} is the voice channel name, and {communityName} is the community name.
#: src/features/app/components/layout/app_layout/nagbars/VoiceSessionRestoreNagbar.tsx
msgid "{productName} restarted while you were connected to the {channelName} channel in the {communityName} community."
msgstr "Lietotne {productName} tika restartēta, kamēr biji pievienojies kanālam {channelName} kopienā {communityName}."

#. Nagbar shown after the app restarts while the user can reconnect to an active DM or group DM call. {productName} is Fluxer and {directCallName} is the DM or group DM display name.
#: src/features/app/components/layout/app_layout/nagbars/VoiceSessionRestoreNagbar.tsx
msgid "{productName} restarted while you were connected to the call in {directCallName}."
msgstr "Lietotne {productName} tika restartēta, kamēr biji pievienojies zvanam sarunā {directCallName}."

#. Desktop updater modal body after a manual update check finds an update to the desktop app itself. Confirming quits the app, installs the update and opens the app again. productName is the app name.
#: src/features/updater/commands/UpdaterModalCommands.tsx
msgid "{productName} restarts to finish updating."
msgstr "Lietotne {productName} tiks restartēta, lai pabeigtu atjaunināšanu."

#. Item in the textarea spellcheck submenu that opens the full settings page. Trailing horizontal ellipsis (…) indicates the action opens settings.
#: src/features/channel/components/textarea/TextareaContextMenu.tsx
msgid "{productName} spellcheck settings…"
msgstr "{productName} pareizrakstības pārbaudes iestatījumi…"

#. Label in the invites disabled modal.
#: src/features/invite/components/alerts/InvitesDisabledModal.tsx
msgid "{productName} spotted a possible raid here. Invites are paused. Try again later."
msgstr "{productName} šeit pamanīja iespējamu reidu. Uzaicinājumi ir apturēti. Mēģini vēlāk."

#. Label in the notifications.
#: src/features/user/components/modals/tabs/notifications_tab/Notifications.tsx
msgid "{productName} uses push notifications when installed as a mobile PWA. Registering lets the gateway send notifications to your device even when the app is in the background."
msgstr "Kad {productName} ir instalēts kā mobilā PWA, tas izmanto push paziņojumus. Reģistrējoties vārteja var sūtīt paziņojumus uz tavu ierīci arī tad, kad lietotne darbojas fonā."

#. Settings search entry description. One-line summary of what the settings search entry controls.
#: src/features/user/components/settings_utils/search_index/DesktopSettingsIndex.ts
msgid "{productName} won't update while starting. When an update is available, you can install it from the app whenever you like. Takes effect the next time {productName} starts."
msgstr "Lietotne {productName} neatjaunināsies palaišanas laikā. Kad būs pieejams atjauninājums, varēsi to instalēt no lietotnes, kad vien vēlies. Stāsies spēkā nākamajā lietotnes {productName} palaišanas reizē."

#. Accessible label for the application wordmark.
#: src/features/ui/components/icons/FluxerWordmark.tsx
msgid "{productName} wordmark"
msgstr "{productName} logotips"

#. Download progress shown under a file name in the downloads panel. {progress} is the formatted percentage downloaded so far, for example 42%. {total} is the formatted size of the whole file, for example 3.2 MB.
#: src/features/app/components/layout/NativeDownloads.tsx
msgid "{progress} of {total}"
msgstr "{progress} no {total}"

#: src/features/connection/components/modals/AddConnectionModal.tsx
msgid "{providerName} opens in your browser. Sign in there to connect your account."
msgstr "{providerName} atvērsies tavā pārlūkā. Pieraksties tur, lai savienotu savu kontu."

#. Reaction tooltip. Preserve {emojiName}, {reactors}; they are inserted by code. {reactorCount} is how many people reacted, for verb agreement. Order the parts so the emoji never reads as the one doing the reacting.
#: src/features/messaging/utils/ReactionUtils.ts
msgid "{reactorCount, plural, one {{emojiName} reacted by {reactors}} other {{emojiName} reacted by {reactors}}}"
msgstr "{reactorCount, plural, zero {{emojiName}: reaģēja {reactors}} one {{emojiName}: reaģēja {reactors}} other {{emojiName}: reaģēja {reactors}}}"

#. Download progress in the desktop update window. {received} and {total} are already formatted numbers of megabytes. Use the local abbreviation for megabytes.
#: src/features/platform/utils/DesktopLocaleBridge.ts
msgid "{received} of {total} MB"
msgstr "{received} no {total} MB"

#. Download progress with the current speed in the desktop update window. {received} and {total} are already formatted numbers of megabytes. {speed} is a formatted speed such as "2.4 MB/s". Use the local abbreviation for megabytes.
#: src/features/platform/utils/DesktopLocaleBridge.ts
msgid "{received} of {total} MB, {speed}"
msgstr "{received} no {total} MB, {speed}"

