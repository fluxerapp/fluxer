root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120
indent_style = tab
indent_size = 2

[*.rs]
indent_style = space
indent_size = 4
max_line_length = 100

[*.gleam]
indent_style = space
indent_size = 2
max_line_length = 80

[*.{c,h,py}]
indent_style = space
indent_size = 4

[fluxer_app/rust/libfluxwebp/**.{c,h}]
indent_style = space
indent_size = 2

[*.{md,mdx,proto,tpl}]
indent_style = space
indent_size = 2

[*.{yml,yaml,Dockerfile}]
indent_style = space
indent_size = 2
