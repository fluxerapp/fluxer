From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Fluxer <support@fluxer.com>
Date: Sat, 17 Oct 2026 14:10:46 +0000
Subject: fix: synchronize VA-API surfaces before output

diff --git a/media/gpu/vaapi/vaapi_video_decoder.cc b/media/gpu/vaapi/vaapi_video_decoder.cc
--- a/media/gpu/vaapi/vaapi_video_decoder.cc
+++ b/media/gpu/vaapi/vaapi_video_decoder.cc
@@ -223,6 +223,7 @@
     transcryption_ = false;
 
     SetState(State::kUninitialized);
+    surface_sync_failed_ = false;
   }
   DCHECK(!current_decode_task_);
   DCHECK(decode_task_queue_.empty());
@@ -404,6 +405,11 @@
   {
     TRACE_EVENT("media,gpu", "VaapiVideoDecoder::Decode");
     decode_result = decoder_->Decode();
+  }
+  if (surface_sync_failed_) {
+    SetState({DecoderStatus::Codes::kFailed,
+              "failed to synchronize VA surface before output"});
+    return;
   }
   switch (decode_result) {
     case AcceleratedVideoDecoder::kRanOutOfStreamData:
@@ -559,6 +565,10 @@
   DVLOGF(4);
   DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
   DCHECK_EQ(state_, State::kDecoding);
+  if (surface_sync_failed_) {
+    return;
+  }
+
   CHECK_NE(va_surface_id, VA_INVALID_SURFACE);
 
   // Find the timestamp associated with |buffer_id|. It's possible that a
@@ -624,6 +634,11 @@
   gfx::HDRMetadata hdr_metadata = static_hdr_metadata_;
   hdr_metadata.MergeMetadataFrom(dynamic_hdr_metadata);
   frame->set_hdr_metadata(hdr_metadata);
+
+  if (!vaapi_wrapper_->SyncSurface(va_surface_id)) {
+    surface_sync_failed_ = true;
+    return;
+  }
   output_cb_.Run(std::move(frame));
 }
 
@@ -1045,7 +1060,13 @@
 
   // Flush will block until SurfaceReady() has been called for every frame
   // currently decoding.
-  if (!decoder_->Flush()) {
+  const bool flush_succeeded = decoder_->Flush();
+  if (surface_sync_failed_) {
+    SetState({DecoderStatus::Codes::kFailed,
+              "failed to synchronize VA surface before output"});
+    return;
+  }
+  if (!flush_succeeded) {
     SetState({DecoderStatus::Codes::kFailed, "Failed to flush the decoder"});
     return;
   }
diff --git a/media/gpu/vaapi/vaapi_video_decoder.h b/media/gpu/vaapi/vaapi_video_decoder.h
--- a/media/gpu/vaapi/vaapi_video_decoder.h
+++ b/media/gpu/vaapi/vaapi_video_decoder.h
@@ -211,6 +211,8 @@
   // The video decoder's state.
   State state_ GUARDED_BY_CONTEXT(sequence_checker_) = State::kUninitialized;
 
+  bool surface_sync_failed_ GUARDED_BY_CONTEXT(sequence_checker_) = false;
+
   // Callback used to notify the client when a frame is available for output.
   PipelineOutputCB output_cb_ GUARDED_BY_CONTEXT(sequence_checker_);
 
