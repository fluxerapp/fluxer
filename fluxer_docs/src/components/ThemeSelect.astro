---
// SPDX-License-Identifier: AGPL-3.0-or-later
import {Icon} from '@astrojs/starlight/components';

const options = [
	{icon: 'sun', label: 'Light', value: 'light'},
	{icon: 'moon', label: 'Dark', value: 'dark'},
	{icon: 'laptop', label: 'System', value: 'auto'},
] as const;
---

<flx-theme-switch role="group" aria-label="Theme">
	{
		options.map((option) => (
			<button type="button" data-theme-value={option.value} aria-pressed="false" title={option.label}>
				<Icon name={option.icon} size="1rem" />
				<span class="sr-only">{option.label}</span>
			</button>
		))
	}
</flx-theme-switch>

<script is:inline>
	StarlightThemeProvider.updatePickers();
</script>

<script>
	type Theme = 'auto' | 'dark' | 'light';

	declare const StarlightThemeProvider: {readonly updatePickers: (theme?: Theme) => void};

	const storageKey = 'starlight-theme';

	const parseTheme = (theme: unknown): Theme =>
		theme === 'auto' || theme === 'dark' || theme === 'light' ? theme : 'auto';

	function loadTheme(): Theme {
		try {
			return parseTheme(localStorage.getItem(storageKey));
		} catch {
			return 'auto';
		}
	}

	function storeTheme(theme: Theme): void {
		try {
			localStorage.setItem(storageKey, theme);
		} catch {}
	}

	const getPreferredColorScheme = (): Theme => (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');

	function onThemeChange(theme: Theme): void {
		StarlightThemeProvider.updatePickers(theme);
		document.documentElement.dataset.theme = theme === 'auto' ? getPreferredColorScheme() : theme;
		storeTheme(theme);
	}

	matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => {
		if (loadTheme() === 'auto') onThemeChange('auto');
	});

	class FlxThemeSwitch extends HTMLElement {
		connectedCallback(): void {
			onThemeChange(loadTheme());
			for (const button of this.querySelectorAll<HTMLButtonElement>('button[data-theme-value]')) {
				button.addEventListener('click', () => onThemeChange(parseTheme(button.dataset.themeValue)));
			}
		}
	}
	if (!customElements.get('flx-theme-switch')) {
		customElements.define('flx-theme-switch', FlxThemeSwitch);
	}
</script>
