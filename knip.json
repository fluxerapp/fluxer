{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"include": ["files", "exports", "types", "dependencies", "unlisted", "binaries", "catalog"],
	"ignoreExportsUsedInFile": true,
	"ignoreDependencies": [
		"@bufbuild/protoc-gen-es",
		"@tailwindcss/cli",
		"@types/events",
		"events",
		"fflate",
		"tailwindcss"
	],
	"ignoreFiles": [
		"fluxer_admin/src/styles/app.css",
		"fluxer_admin/static/htmx.min.js",
		"tools/ci/templates/libfluxcore_wrapper.d.ts",
		"tools/ci/templates/libfluxcore_wrapper.js"
	],
	"ignoreIssues": {
		"fluxer_app/scripts/build/Config.tsx": ["exports"],
		"fluxer_app/scripts/build/rspack/static-files.mjs": ["exports"],
		"fluxer_app/src/index.tsx": ["unlisted"],
		"fluxer_desktop/native/mac-app-audio/index.test.mjs": ["unlisted"],
		"fluxer_desktop/src/common/DesktopConfig.ts": ["types"],
		"fluxer_desktop/src/common/Types.ts": ["types"],
		"fluxer_desktop/src/main/Autostart.ts": ["exports"],
		"fluxer_desktop/src/main/LinuxDesktopEntry.ts": ["exports"],
		"fluxer_desktop/src/main/NotificationState.ts": ["exports", "types"],
		"packages/schema/src/domains/admin/AdminUserSchemas.ts": ["exports"],
		"packages/schema/src/domains/admin/PushServiceDeliverySchemas.ts": ["exports"],
		"packages/schema/src/domains/admin/VoiceNoiseSuppressionSchemas.ts": ["exports"],
		"packages/schema/src/domains/download/DownloadSchemas.ts": ["exports"],
		"packages/schema/src/domains/geolocation/GeolocationSchemas.ts": ["exports"],
		"packages/schema/src/domains/guild/GuildAuditLogSchemas.ts": ["exports"],
		"pnpm-workspace.yaml": ["catalog"]
	},
	"workspaces": {
		".": {
			"ignoreDependencies": ["vite"]
		},
		"fluxer_api": {
			"ignoreDependencies": [
				"@elastic/elasticsearch",
				"@hono/node-server",
				"@messageformat/core",
				"@messageformat/parser",
				"@vvo/tzdb",
				"emoji-regex",
				"ioredis",
				"maxmind",
				"nodemailer",
				"pg",
				"pino",
				"undici",
				"validator"
			]
		},
		"fluxer_app": {
			"entry": ["lingui.config.js", "scripts/build-sw.mjs", "scripts/Generate*.ts"]
		},
		"fluxer_desktop": {
			"entry": [
				"src/main/Bootstrap.ts",
				"src/main/index.ts",
				"src/preload/index.ts",
				"src/main/**/*.test.{ts,mjs}",
				"native/*/index.{js,d.ts}",
				"native/*/loader-diagnostics.cjs",
				"native/*/*.test.mjs",
				"native/*/test/**/*.mjs"
			],
			"project": ["src/**/*.{ts,tsx,mjs,js}", "scripts/**/*.mjs", "native/**/*.{js,mjs,cjs,d.ts}"],
			"ignoreBinaries": ["reg.exe", "update-desktop-database"],
			"ignoreDependencies": ["electron-builder", "electron-builder-squirrel-windows"]
		},
		"fluxer_docs": {
			"entry": ["scripts/*.ts", "src/**/*.astro"],
			"project": ["src/**/*.{ts,astro,mdx}", "scripts/**/*.ts"]
		},
		"packages/openapi": {
			"project": ["src/**/*.ts"]
		},
		"packages/schema": {
			"project": ["src/**/*.ts", "!src/gen/**"]
		},
		"packages/voice_engine_v2": {
			"entry": ["src/**/*.bench.ts"]
		}
	}
}
