<mjml lang="%%lang%%" dir="[[dir]]">
	<mj-include path="./partials/head.mjml" />
	<mj-body width="600px" background-color="#ffffff" css-class="x-page">
		<mj-section padding="32px 24px 0" css-class="x-pad">
			<mj-column>
				<mj-raw>
					<tr>
						<td dir="[[dir]]" style="padding:0;font-family:[[font]];text-align:[[start]];direction:[[dir]]">
							%%?logo_url%%<a href="%%home_url%%" target="_blank" class="x-light" style="display:inline-block;text-decoration:none"><img src="%%logo_url%%" width="92" height="24" alt="%%product_name%%" style="display:block;width:92px;height:24px;border:0;font-size:18px;line-height:24px;font-weight:700;color:#4641d9"></a><!--[if !mso]><!--><div class="x-dark" style="display:none;max-height:0;overflow:hidden;mso-hide:all"><a href="%%home_url%%" target="_blank" style="display:inline-block;text-decoration:none"><img src="%%logo_dark_url%%" width="92" height="24" alt="%%product_name%%" style="display:block;width:92px;height:24px;border:0;font-size:18px;line-height:24px;font-weight:700;color:#ffffff"></a></div><!--<![endif]-->%%/logo_url%%
							%%?wordmark%%<a href="%%home_url%%" target="_blank" class="x-ink" style="font-size:18px;line-height:24px;font-weight:700;color:#1b1a2e;text-decoration:none">%%wordmark%%</a>%%/wordmark%%
						</td>
					</tr>
				</mj-raw>
			</mj-column>
		</mj-section>
		<mj-section padding="20px 24px 0" css-class="x-pad">
			<mj-column>
				<mj-raw>
					<tr>
						<td style="padding:0">
							<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" dir="[[dir]]" style="width:100%;border-collapse:collapse;direction:[[dir]];text-align:[[start]]">
								%%?heading%%<tr>
									<td dir="[[dir]]" class="x-ink" style="padding:0 0 12px;font-family:[[font]];text-align:[[start]];direction:[[dir]]"><h1 class="x-ink" style="margin:0;font-family:[[font]];font-size:22px;line-height:28px;font-weight:700;color:#1b1a2e;overflow-wrap:anywhere;word-break:break-word">%%heading%%</h1></td>
								</tr>%%/heading%%
								<tr>
									<td dir="[[dir]]" class="x-ink" style="padding:0;font-family:[[font]];font-size:16px;line-height:24px;color:#1b1a2e;text-align:[[start]];direction:[[dir]];overflow-wrap:anywhere;word-break:break-word">%%intro%%</td>
								</tr>
								%%?code%%<tr>
									<td dir="ltr" class="x-ink" style="padding:16px 0 0;font-family:[[mono]];font-size:28px;line-height:36px;font-weight:700;letter-spacing:3px;color:#1b1a2e;text-align:[[start]];white-space:nowrap">%%code%%</td>
								</tr>%%/code%%
								<mj-include path="./partials/fact-row.mjml" n="1" top="16px" />
								<mj-include path="./partials/fact-row.mjml" n="2" top="4px" />
								<mj-include path="./partials/fact-row.mjml" n="3" top="4px" />
								<mj-include path="./partials/fact-row.mjml" n="4" top="4px" />
								<mj-include path="./partials/fact-row.mjml" n="5" top="4px" />
								<mj-include path="./partials/fact-row.mjml" n="6" top="4px" />
								<mj-include path="./partials/fact-row.mjml" n="7" top="4px" />
								<mj-include path="./partials/summary.mjml" />
								%%?points_list%%<tr>
									<td dir="[[dir]]" class="x-ink" style="padding:16px 0 0;font-family:[[font]];font-size:16px;line-height:24px;color:#1b1a2e;text-align:[[start]];direction:[[dir]];overflow-wrap:anywhere;word-break:break-word">
										<ul dir="auto" style="margin:0;padding-[[start]]:20px;text-align:start">%%points_list%%</ul>
									</td>
								</tr>%%/points_list%%
								<mj-include path="./partials/text-row.mjml" slot="lead" />
								<mj-include path="./partials/notice-box.mjml" />
								%%?cta%%<tr>
									<td align="[[start]]" style="padding:24px 0 0">
										<table role="presentation" cellpadding="0" cellspacing="0" border="0" align="[[start]]" style="border-collapse:separate">
											<tr>
												<td align="center" bgcolor="#4641d9" style="border-radius:6px;background-color:#4641d9;mso-padding-alt:12px 22px">
													<a href="%%cta_url%%" target="_blank" class="x-btn" style="display:inline-block;padding:12px 22px;font-family:[[font]];font-size:16px;line-height:22px;font-weight:600;color:#ffffff;text-decoration:none;border-radius:6px">%%cta%%</a>
												</td>
											</tr>
										</table>
									</td>
								</tr>%%/cta%%
								<mj-include path="./partials/muted-row.mjml" slot="expiry" gap="12px" />
								<mj-include path="./partials/text-row.mjml" slot="text_1" />
								<mj-include path="./partials/text-row.mjml" slot="text_2" />
								<mj-include path="./partials/section.mjml" n="1" />
								<mj-include path="./partials/section.mjml" n="2" />
								<mj-include path="./partials/section.mjml" n="3" />
								<mj-include path="./partials/section.mjml" n="4" />
								<mj-include path="./partials/muted-row.mjml" slot="note" gap="16px" />
								%%?end_link%%<tr>
									<td dir="[[dir]]" style="padding:16px 0 0;font-family:[[font]];font-size:16px;line-height:24px;text-align:[[start]];direction:[[dir]]"><a href="%%end_link_url%%" class="x-link" style="color:#4641d9">%%end_link%%</a></td>
								</tr>%%/end_link%%
								<tr>
									<td dir="[[dir]]" class="x-ink" style="padding:24px 0 0;font-family:[[font]];font-size:16px;line-height:24px;color:#1b1a2e;text-align:[[start]];direction:[[dir]]">%%signoff%%</td>
								</tr>
							</table>
						</td>
					</tr>
				</mj-raw>
			</mj-column>
		</mj-section>
		<mj-section padding="32px 24px 40px" css-class="x-pad">
			<mj-column>
				<mj-raw>
					<tr>
						<td dir="[[dir]]" class="x-muted x-rule" style="padding:16px 0 0;border-top:1px solid #e4e3ec;font-family:[[font]];font-size:13px;line-height:20px;color:#5b5a70;text-align:[[start]];direction:[[dir]]">
							<div style="margin:0">%%footer_reason%%</div>
							%%?unsubscribe%%<p style="margin:8px 0 0"><a href="%%unsubscribe_url%%" style="color:inherit;text-decoration:underline">%%unsubscribe%%</a></p>%%/unsubscribe%%
							%%?legal_address%%<p dir="ltr" style="margin:8px 0 0;text-align:[[start]]">%%legal_address%%</p>%%/legal_address%%
						</td>
					</tr>
				</mj-raw>
			</mj-column>
		</mj-section>
	</mj-body>
</mjml>
