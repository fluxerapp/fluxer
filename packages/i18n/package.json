{
	"name": "@fluxer/i18n",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		"./*": "./*"
	},
	"scripts": {
		"generate:types": "tsx scripts/GenerateI18nTypes.ts",
		"static:sync": "tsx scripts/SyncStaticI18nCatalogs.ts",
		"test": "vitest run",
